{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true"
      }
    },

    "catalog": {
      "$classKey": {
        ".read": "auth != null && (auth.token.admin === true || root.child('users').child(auth.uid).child('class').val() === $classKey.replace('class-', ''))",
        ".write": "auth != null && auth.token.admin === true",
        "$materialId": {
          ".validate": "newData.hasChildren(['title','class','subject','section','storagePath','fileName','type','active','createdAt','updatedAt'])"
        }
      }
    },

    "recent": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["lastOpened"]
      }
    }
  }
}
