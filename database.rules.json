{
  "rules": {
    "catalog": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'creativesayeedd@gmail.com'"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
